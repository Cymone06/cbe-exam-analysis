# Supabase — copy to `.env.local` and fill in your project's values.
# The publishable (anon) key is safe for frontend use; never use a service-role
# or secret key here — it must only live server-side (Edge Functions).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ-your-publishable-anon-key
