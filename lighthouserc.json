{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.8 }],
        "categories:seo": "off",
        "categories:pwa": "off",
        "audits:installable-manifest": "off",
        "audits:service-worker-registration": "off",
        "audits:works-offline": "off",
        "audits:offline-start-url": "off",
        "audits:apple-touch-icon": "off",
        "audits:splash-screen": "off",
        "audits:themed-omnibox": "off",
        "audits:content-width": "off",
        "audits:viewport": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
